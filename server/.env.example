# Port for the Node.js Express server to listen on
PORT=5000

# Connection URI to MongoDB database
MONGODB_URI=mongodb://localhost:27017/shivaay_library

# Secret key used for signing JWT tokens. 
# Make sure to use a long, complex, and unique random string in production!
JWT_SECRET=use_a_very_long_secure_random_string_here

# Password used to seed the default administrator account (admin@shivaay.com)
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# URL of the frontend client application to authorize CORS requests
FRONTEND_URL=http://localhost:5173
