# Server Configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Connection String (Prisma)
DATABASE_URL=postgresql://shivaay:shivaay_local_dev_pw@localhost:5432/shivaay_library?schema=public

# Cryptographic Secrets (MUST be long random 64-char hex/base64 strings in production)
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_refresh_secret
CSRF_SECRET=replace_with_64_char_random_hex_csrf_secret
TOTP_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_2fa_secrets
QR_SIGNING_SECRET=replace_with_64_char_random_hex_qr_secret

# Cookie & CORS Configuration
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
FORCE_HTTPS=false

# Seed Admin Account (used only by seed script when no admin exists)
ADMIN_NAME=Shivaay Library Admin
ADMIN_EMAIL=admin@shivaaylibrary.com
ADMIN_PASSWORD=ChangeMe@2026!

# Razorpay (Module 4 - backend only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Module 8 - backend only)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
